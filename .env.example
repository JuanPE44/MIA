# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
AI_SIMULATED=true
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (auth + plans). See README "Auth local". ---
# Browser (exposed to the client bundle; the anon key is public by design).
# Without these the app shows the login screen with a "Supabase not configured" notice.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"

# Server only (never expose). Without these the API runs with no auth, as an anonymous "pro" dev user.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY"

# Google OAuth client (Google Cloud Console). Read by the Supabase CLI for local auth
# (put them in supabase/.env so `supabase start` picks them up).
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"
