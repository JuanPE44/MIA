# --- AI ---
# AI_SIMULATED: anything other than "false" keeps every AI feature on local heuristics (no Gemini calls, no cost).
# Set to "false" AND provide GEMINI_API_KEY to use real Gemini responses.
AI_SIMULATED=true
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used by AI Studio; not required on Vercel).
APP_URL="MY_APP_URL"

# --- Supabase (auth + plans). See README "Auth local" and DEPLOY.md. ---
# Browser (baked into the client bundle at BUILD time; the anon key is public by design).
# Without these the app shows the login screen with a "Supabase not configured" notice.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"

# Server only (never expose).
# Locally, without these the API runs as an anonymous "pro" dev user.
# In production (NODE_ENV=production or on Vercel), missing values make /api return 503 AUTH_NOT_CONFIGURED.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY"

# Google OAuth client (Google Cloud Console). Read by the Supabase CLI for local auth
# (put them in supabase/.env so `supabase start` picks them up). In production, configure them in the Supabase dashboard.
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"
